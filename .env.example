# ===================================================================
# AURA AI — Production Environment Variables Configuration Template
# ===================================================================

# Flask Secret Key (Generate a random string for production session security)
SECRET_KEY=aura-continuous-biometrics-production-secret-98214

# Production Port (Automatically assigned by Render / Railway / Fly.io)
PORT=5000

# -------------------------------------------------------------------
# Cloud MySQL Database Configuration (Aiven / Railway / PlanetScale / TiDB)
# -------------------------------------------------------------------
# Option A: Single Connection URL (Recommended for Railway & Aiven)
# DATABASE_URL=mysql://avnadmin:your_password@your-mysql-instance.aivencloud.com:12345/biometric_auth_db?ssl-mode=REQUIRED

# Option B: Individual Connection Parameters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_DB=biometric_auth_db
MYSQL_SSL=false
